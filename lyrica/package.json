{
  "name": "lyrica",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage",
    "clean:watchman": "watchman watch-del-all 2>/dev/null || true",
    "clean:metro": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-*",
    "clean:gradle": "cd android && ./gradlew clean && cd ..",
    "clean:node": "rm -rf node_modules/ && npm i",
    "clean:basic": "npm run clean:watchman && npm run clean:metro && npm run clean:gradle",
    "clean": "npm run clean:basic && npm run clean:node",
    "typecheck": "tsc --noEmit",
    "pods:install": "cd ios && pod install && cd ..",
    "pods:refresh": "cd ios && pod deintegrate && rm -rf Pods Podfile.lock && npm run pods:install",
    "android:menu": "adb shell input keyevent 82",
    "devtools": "react-devtools"
  },
  "dependencies": {
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/firestore": "^23.4.1",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.5.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.20",
    "expo-dev-client": "~6.0.16",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-storage": "^54.0.6",
    "jest-expo": "~54.0.13",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-pager-view": "^6.9.1",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.8"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "19.1.0",
    "@types/react-native": "^0.72.8",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "jest": "^29.7.0",
    "react-test-renderer": "19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
