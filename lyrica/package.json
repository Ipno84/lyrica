{
  "name": "lyrica",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean:watchman": "watchman watch-del-all 2>/dev/null || true",
    "clean:gradle": "cd android && ./gradlew clean && cd ..",
    "clean:metro": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-*",
    "clean:node": "rm -rf node_modules/ && pnpm i",
    "clean": "pnpm run clean:watchman && pnpm run clean:metro && pnpm run clean:gradle && pnpm run clean:node",
    "typecheck": "tsc --noEmit",
    "pods:install": "cd ios && pod install && cd .."
  },
  "dependencies": {
    "expo": "~54.0.20",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
